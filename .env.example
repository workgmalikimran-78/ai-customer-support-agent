# --- Postgres (used by backend) ---
POSTGRES_DB=support_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- AI service (Python) ---
ANTHROPIC_API_KEY=
LLM_MODEL_ID=claude-sonnet-4-6
AI_SERVICE_API_KEY=dev-shared-secret

# --- Backend (Spring Boot) ---
JWT_SECRET=dev-only-secret-change-me
# HMAC shared secret for verifying inbound channel webhooks (see docs/api-contracts.md)
WEBHOOK_SHARED_SECRET=dev-webhook-secret-change-me
# Comma-separated browser origins allowed to call the API with credentials -- no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to true for any deployment reachable outside localhost: the backend will refuse to
# start if JWT_SECRET / AI_SERVICE_API_KEY / WEBHOOK_SHARED_SECRET are still these defaults.
REQUIRE_STRONG_SECRETS=false

# --- Frontend (React, baked in at build time) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
